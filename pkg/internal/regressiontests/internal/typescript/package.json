{
    "dependencies": {
        "@bsv/sdk": "^4.0.0",
        "@bufbuild/protobuf": "^2.16.0",
        "@grpc/grpc-js": "^1.14.7",
        "minimist": "^1.2.8"
    },
    "description": "Minimal Node.js + TypeScript gRPC server exposing an async fetch method.",
    "devDependencies": {
        "@types/minimist": "^1.2.5",
        "@types/node": "^24.19.2",
        "ts-proto": "^2.18.4",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=22"
    },
    "license": "Apache-2.0",
    "main": "dist/server.js",
    "name": "grpc-bsv-typescript-server",
    "private": true,
    "scripts": {
        "build": "npm run clean && npm run proto:gen && tsc",
        "clean": "rm -rf dist src/gen",
        "client": "npm run proto:gen && tsx watch src/client/client.ts --url http://localhost:8888/ping",
        "dev": "npm run proto:gen && tsx watch src/server.ts",
        "proto:gen": "mkdir -p src/gen && protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/gen --ts_proto_opt=outputServices=grpc-js,env=node,esModuleInterop=true,useExactTypes=false -I ./proto ./proto/*.proto",
        "start": "npm run build && node dist/server.js"
    },
    "version": "0.1.0"
}
